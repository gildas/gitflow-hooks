#!/usr/bin/env bash

if [[ -z $HOOKS_DIR ]]; then
  HOOKS_DIR="$0"
  while [[ -h $HOOKS_DIR ]]; do HOOK_PATH=$(readlink "$HOOKS_DIR"); done
  HOOKS_DIR=$(dirname $HOOKS_DIR)
fi
source "$HOOKS_DIR"/functions.sh
[[ -f "$HOOKS_DIR"/functions-lang.sh ]] && source "$HOOKS_DIR"/functions-lang.sh

trace "Hook: pre-commit"

# Runs the user's custom pre-commit hook, if any, after ours
# Its location comes from gitflow.path.pre-commit (relative to the repository root), defaults to pre-commit.local in the hooks folder
function run_custom_pre_commit() { # {{{2
  local custom_hook
  custom_hook=$(git config --get gitflow.path.pre-commit)
  if [[ -n $custom_hook ]]; then
    [[ $custom_hook != /* ]] && custom_hook="$ROOT_DIR/$custom_hook"
    [[ -e $custom_hook ]] || die "The custom pre-commit hook $custom_hook (gitflow.path.pre-commit) does not exist"
  else
    custom_hook="$HOOKS_DIR/pre-commit.local"
    [[ -e $custom_hook ]] || exit 0
  fi
  [[ -x $custom_hook ]] || die "The custom pre-commit hook $custom_hook is not executable, run: chmod +x $custom_hook"
  verbose "Running the custom pre-commit hook $custom_hook"
  exec "$custom_hook" "$@"
} # 2}}}

if ! get_config_bool gitflow.allow-master-commit; then
  verbose "Checking if the current branch is the $MASTER_BRANCH branch"
  if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    verbose "Merge in progress, skipping branch check"
    run_custom_pre_commit "$@"
  fi
  BRANCH=$(git symbolic-ref HEAD)
  [[ $BRANCH == "refs/heads/$MASTER_BRANCH" ]] && die "Direct commits to the $MASTER_BRANCH branch are forbidden"
fi

# Check if there is any merge that is not resolved in the files to commit
if ! get_config_bool gitflow.allow-conflict-commit; then
  files_to_merge=()
  for file in $(git diff-index --name-only --diff-filter=ACM --cached HEAD --); do
    if grep -Erls "^<<<<<<< |^>>>>>>> $" "$file" 2>&1 >/dev/null; then
      if ! is_binary "$file"; then
        files_to_merge=($files_to_merge $file)
      fi
    fi
  done
  [[ ${#files_to_merge[@]} > 0 ]] && die "Resolve these merges before committing! ${files_to_merge[@]}"
fi

if get_config_bool gitflow.prettify true; then
  verbose "Prettifying staged files..."
  if declare -F prettify_staged_files &>/dev/null; then
    prettify_staged_files
    die_on_error "Fix the formatting errors and try again"
  fi
fi

if get_config_bool gitflow.must-pass-lint true; then
  verbose "Linting staged files..."
  if declare -F lint_staged_files &>/dev/null; then
    lint_staged_files
    die_on_error "Fix the lint errors and try again"
  fi
fi

run_custom_pre_commit "$@"
