#!/usr/bin/env bash

# Runs before of git flow release finish
#
# Positional arguments:
# $1    The version (including the version prefix)
# $2    The origin remote
# $3    The full branch name (including the release prefix)
#
# The following variables are available as they are exported by git-flow:
#
# MASTER_BRANCH - The branch defined as Master
# DEVELOP_BRANCH - The branch defined as Develop
#
# git-flow-next does not export them (functions.sh sets them), it exports BASE_BRANCH (the branch to merge into)
#
# @see https://github.com/petervanderdoes/gitflow-avh/blob/develop/hooks/pre-flow-release-finish
VERSION=$1
ORIGIN=$2
BRANCH=$3

# Find the folder location through potential symlinks
if [[ -z $HOOKS_DIR ]]; then
  HOOKS_DIR="$0"
  # Follow the symlinks to the real hook, a relative target is relative to the folder of the link
  while [[ -h $HOOKS_DIR ]]; do
    HOOK_PATH=$(readlink "$HOOKS_DIR")
    [[ $HOOK_PATH == /* ]] && HOOKS_DIR=$HOOK_PATH || HOOKS_DIR="$(dirname "$HOOKS_DIR")/$HOOK_PATH"
  done
  HOOKS_DIR=$(dirname "$HOOKS_DIR")
fi
source "$HOOKS_DIR"/functions.sh

trace "Hook: pre-flow-release-finish"
verbose "Finishing release $VERSION from ${ORIGIN:+$ORIGIN/}$BRANCH"

if get_config_bool gitflow.use-pull-request true; then
  PR_STATE=$(get_pull_request_state $ORIGIN $BRANCH)
  die_on_error "There is no Pull Request for branch $BRANCH, please publish this release before finishing it."
  verbose "Pull Request state for branch $BRANCH is: $PR_STATE"
  if [[ -n ${PR_STATE} &&  ${PR_STATE^^} != MERGED ]]; then
    die "There is a Pull Request that is not yet merged, please wait (Status: $PR_STATE)"
  fi
else
  verbose "Pull requests are disabled."
fi

# Make sure git flow merges into up-to-date branches
pull_branch "$ORIGIN" "$MASTER_BRANCH"
die_on_error "Failed to pull $MASTER_BRANCH from $ORIGIN"
pull_branch "$ORIGIN" "$DEVELOP_BRANCH"
die_on_error "Failed to pull $DEVELOP_BRANCH from $ORIGIN"

run_custom_hook pre-flow-release-finish "$@"
exit 0
